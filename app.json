{
  "expo": {
    "name": "alexyerick-invitacion",
    "slug": "alexyerick-invitacion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "alexyerickinvitacion",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Cormorant Garamond",
                "fontDefinitions": [
                  { "path": "./public/fonts/CormorantGaramond-Light.ttf", "weight": 300 },
                  { "path": "./public/fonts/CormorantGaramond-LightItalic.ttf", "weight": 300, "style": "italic" },
                  { "path": "./public/fonts/CormorantGaramond-Regular.ttf", "weight": 400 },
                  { "path": "./public/fonts/CormorantGaramond-Medium.ttf", "weight": 500 },
                  { "path": "./public/fonts/CormorantGaramond-SemiBold.ttf", "weight": 600 },
                  { "path": "./public/fonts/CormorantGaramond-Bold.ttf", "weight": 700 }
                ]
              },
              {
                "fontFamily": "Raleway",
                "fontDefinitions": [
                  { "path": "./public/fonts/Raleway_100Thin.ttf", "weight": 100 },
                  { "path": "./public/fonts/Raleway_100Thin_Italic.ttf", "weight": 100, "style": "italic" },
                  { "path": "./public/fonts/Raleway_200ExtraLight.ttf", "weight": 200 },
                  { "path": "./public/fonts/Raleway_200ExtraLight_Italic.ttf", "weight": 200, "style": "italic" },
                  { "path": "./public/fonts/Raleway_300Light.ttf", "weight": 300 },
                  { "path": "./public/fonts/Raleway_300Light_Italic.ttf", "weight": 300, "style": "italic" },
                  { "path": "./public/fonts/Raleway_400Regular.ttf", "weight": 400 },
                  { "path": "./public/fonts/Raleway_400Regular_Italic.ttf", "weight": 400, "style": "italic" },
                  { "path": "./public/fonts/Raleway_500Medium.ttf", "weight": 500 },
                  { "path": "./public/fonts/Raleway_500Medium_Italic.ttf", "weight": 500, "style": "italic" },
                  { "path": "./public/fonts/Raleway_600SemiBold.ttf", "weight": 600 },
                  { "path": "./public/fonts/Raleway_600SemiBold_Italic.ttf", "weight": 600, "style": "italic" },
                  { "path": "./public/fonts/Raleway_700Bold.ttf", "weight": 700 },
                  { "path": "./public/fonts/Raleway_700Bold_Italic.ttf", "weight": 700, "style": "italic" },
                  { "path": "./public/fonts/Raleway_800ExtraBold.ttf", "weight": 800 },
                  { "path": "./public/fonts/Raleway_800ExtraBold_Italic.ttf", "weight": 800, "style": "italic" },
                  { "path": "./public/fonts/Raleway_900Black.ttf", "weight": 900 },
                  { "path": "./public/fonts/Raleway_900Black_Italic.ttf", "weight": 900, "style": "italic" }
                ]
              },
              {
                "fontFamily": "Montserrat",
                "fontDefinitions": [
                  { "path": "./public/fonts/Montserrat_100Thin.ttf", "weight": 100 },
                  { "path": "./public/fonts/Montserrat_100Thin_Italic.ttf", "weight": 100, "style": "italic" },
                  { "path": "./public/fonts/Montserrat_200ExtraLight.ttf", "weight": 200 },
                  { "path": "./public/fonts/Montserrat_200ExtraLight_Italic.ttf", "weight": 200, "style": "italic" },
                  { "path": "./public/fonts/Montserrat_300Light.ttf", "weight": 300 },
                  { "path": "./public/fonts/Montserrat_300Light_Italic.ttf", "weight": 300, "style": "italic" },
                  { "path": "./public/fonts/Montserrat_400Regular.ttf", "weight": 400 },
                  { "path": "./public/fonts/Montserrat_400Regular_Italic.ttf", "weight": 400, "style": "italic" },
                  { "path": "./public/fonts/Montserrat_500Medium.ttf", "weight": 500 },
                  { "path": "./public/fonts/Montserrat_500Medium_Italic.ttf", "weight": 500, "style": "italic" },
                  { "path": "./public/fonts/Montserrat_600SemiBold.ttf", "weight": 600 },
                  { "path": "./public/fonts/Montserrat_600SemiBold_Italic.ttf", "weight": 600, "style": "italic" },
                  { "path": "./public/fonts/Montserrat_700Bold.ttf", "weight": 700 },
                  { "path": "./public/fonts/Montserrat_700Bold_Italic.ttf", "weight": 700, "style": "italic" },
                  { "path": "./public/fonts/Montserrat_800ExtraBold.ttf", "weight": 800 },
                  { "path": "./public/fonts/Montserrat_800ExtraBold_Italic.ttf", "weight": 800, "style": "italic" },
                  { "path": "./public/fonts/Montserrat_900Black.ttf", "weight": 900 },
                  { "path": "./public/fonts/Montserrat_900Black_Italic.ttf", "weight": 900, "style": "italic" }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./public/fonts/CormorantGaramond-Light.ttf",
              "./public/fonts/CormorantGaramond-LightItalic.ttf",
              "./public/fonts/CormorantGaramond-Regular.ttf",
              "./public/fonts/CormorantGaramond-Medium.ttf",
              "./public/fonts/CormorantGaramond-SemiBold.ttf",
              "./public/fonts/CormorantGaramond-Bold.ttf",
              "./public/fonts/Raleway_100Thin.ttf",
              "./public/fonts/Raleway_100Thin_Italic.ttf",
              "./public/fonts/Raleway_200ExtraLight.ttf",
              "./public/fonts/Raleway_200ExtraLight_Italic.ttf",
              "./public/fonts/Raleway_300Light.ttf",
              "./public/fonts/Raleway_300Light_Italic.ttf",
              "./public/fonts/Raleway_400Regular.ttf",
              "./public/fonts/Raleway_400Regular_Italic.ttf",
              "./public/fonts/Raleway_500Medium.ttf",
              "./public/fonts/Raleway_500Medium_Italic.ttf",
              "./public/fonts/Raleway_600SemiBold.ttf",
              "./public/fonts/Raleway_600SemiBold_Italic.ttf",
              "./public/fonts/Raleway_700Bold.ttf",
              "./public/fonts/Raleway_700Bold_Italic.ttf",
              "./public/fonts/Raleway_800ExtraBold.ttf",
              "./public/fonts/Raleway_800ExtraBold_Italic.ttf",
              "./public/fonts/Raleway_900Black.ttf",
              "./public/fonts/Raleway_900Black_Italic.ttf",
              "./public/fonts/Montserrat_100Thin.ttf",
              "./public/fonts/Montserrat_100Thin_Italic.ttf",
              "./public/fonts/Montserrat_200ExtraLight.ttf",
              "./public/fonts/Montserrat_200ExtraLight_Italic.ttf",
              "./public/fonts/Montserrat_300Light.ttf",
              "./public/fonts/Montserrat_300Light_Italic.ttf",
              "./public/fonts/Montserrat_400Regular.ttf",
              "./public/fonts/Montserrat_400Regular_Italic.ttf",
              "./public/fonts/Montserrat_500Medium.ttf",
              "./public/fonts/Montserrat_500Medium_Italic.ttf",
              "./public/fonts/Montserrat_600SemiBold.ttf",
              "./public/fonts/Montserrat_600SemiBold_Italic.ttf",
              "./public/fonts/Montserrat_700Bold.ttf",
              "./public/fonts/Montserrat_700Bold_Italic.ttf",
              "./public/fonts/Montserrat_800ExtraBold.ttf",
              "./public/fonts/Montserrat_800ExtraBold_Italic.ttf",
              "./public/fonts/Montserrat_900Black.ttf",
              "./public/fonts/Montserrat_900Black_Italic.ttf"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
