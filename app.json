{
  "expo": {
    "name": "alexyerick-invitacion",
    "slug": "alexyerick-invitacion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "alexyerickinvitacion",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Cormorant Garamond",
                "fontDefinitions": [
                  { "path": "./public/fonts/CormorantGaramond-Light.ttf", "weight": 300 },
                  { "path": "./public/fonts/CormorantGaramond-LightItalic.ttf", "weight": 300, "style": "italic" },
                  { "path": "./public/fonts/CormorantGaramond-Regular.ttf", "weight": 400 },
                  { "path": "./public/fonts/CormorantGaramond-Medium.ttf", "weight": 500 },
                  { "path": "./public/fonts/CormorantGaramond-SemiBold.ttf", "weight": 600 },
                  { "path": "./public/fonts/CormorantGaramond-Bold.ttf", "weight": 700 }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./public/fonts/CormorantGaramond-Light.ttf",
              "./public/fonts/CormorantGaramond-LightItalic.ttf",
              "./public/fonts/CormorantGaramond-Regular.ttf",
              "./public/fonts/CormorantGaramond-Medium.ttf",
              "./public/fonts/CormorantGaramond-SemiBold.ttf",
              "./public/fonts/CormorantGaramond-Bold.ttf"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
